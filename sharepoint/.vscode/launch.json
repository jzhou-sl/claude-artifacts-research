{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug on SharePoint page",
      "type": "msedge",
      "request": "launch",
      "url": "https://${env:SPFX_SERVE_TENANT_DOMAIN}/sites/NewcastleSocialCommittee/SitePages/SPFx-dev.aspx?debug=true&noredir=true&debugManifestsFile=https://localhost:4321/temp/build/manifests.js",
      "webRoot": "${workspaceRoot}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///.././src/*": "${webRoot}/src/*",
        "webpack:///../../../src/*": "${webRoot}/src/*",
        "webpack:///../../../../src/*": "${webRoot}/src/*",
        "webpack:///../../../../../src/*": "${webRoot}/src/*"
      },
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "-incognito"
      ]
    }
  ]
}