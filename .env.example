# Copy to .env (git-ignored). Read by `npm start`.
SPFX_SERVE_TENANT_DOMAIN=scottlogic.sharepoint.com
# Web parts `npm start` bundles: comma-separated keys or file names from pages.json. Empty = all.
# `npm run build` always bundles every page.
SPFX_WEB_PARTS=

# profile-mcp (mcp/profile): app registration with delegated User.Read only. Read by mcp/profile (run it with node --env-file-if-exists=.env).
PROFILE_TENANT_ID=
PROFILE_CLIENT_ID=
